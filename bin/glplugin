#!/usr/bin/env node

const command = process.argv[2];
const args = process.argv.slice(3);

const commands = {
  init: () => require('../lib/init')(args[0]),
  build: () => require('../lib/build')(),
  deploy: () => require('../lib/deploy')(args[0]),
  extract: () => require('../lib/extract')(args[0]),
  help: () => printHelp(),
};

function printHelp() {
  console.log(`
  gl-sdk4-plugin-kit — Build native GL.iNet admin panel plugins

  Usage:
    glplugin init <name>       Scaffold a new plugin project
    glplugin build             Build plugin (webpack + gzip)
    glplugin deploy <host>     Deploy to router (e.g. root@192.168.8.1)
    glplugin extract <host>    Extract component info from router firmware
    glplugin help              Show this help

  Examples:
    glplugin init my-scanner
    cd my-scanner && npm install && glplugin build
    glplugin deploy root@192.168.14.1
  `);
}

if (!command || !commands[command]) {
  printHelp();
  process.exit(command ? 1 : 0);
} else {
  commands[command]();
}
