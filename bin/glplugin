#!/usr/bin/env node

'use strict';

const pkg = require('../package.json');

const command = process.argv[2];
const args = process.argv.slice(3);

function printHelp() {
  console.log(`
  gl-sdk4-plugin-kit - Build native GL.iNet admin panel plugins

  Usage:
    glplugin init <name> [--profile <profile>]
                                        Scaffold a ui-only or full-stack plugin
    glplugin build                       Build plugin (webpack + gzip)
    glplugin package                     Create an installable .ipk package
    glplugin deploy <host>               Deploy to router via SCP
      [--insecure-host-key]              Disable SSH host-key verification
    glplugin extract root@<host>         Extract components via SSH
      [--insecure-host-key]              Disable SSH host-key verification
    glplugin extract <host> --rpc        Discover API endpoints via HTTP
      [--password-stdin] [--include-sensitive]
    glplugin extract root@<host> --full  Run both SSH and RPC extraction
      [--password-stdin] [--include-sensitive] [--insecure-host-key]
    glplugin test <host>                 Test against a live router
    glplugin doctor <host>               Detect firmware and read-only capabilities
    glplugin --version                   Print the toolkit version
    glplugin help                        Show this help

  Examples:
    glplugin init my-scanner --profile full-stack
    cd my-scanner && npm install && npm run build
    npm run package
    glplugin deploy root@192.168.8.1
  `);
}

const commands = {
  init: function() { return require('../lib/init').cli(args); },
  build: function() { return require('../lib/build')(); },
  package: function() { return require('../lib/package')(); },
  deploy: function() { return require('../lib/deploy')(args); },
  extract: function() { return require('../lib/extract')(args); },
  test: function() { return require('../lib/test')(args); },
  doctor: function() { return require('../lib/doctor')(args); },
  help: printHelp,
};

function reportError(error) {
  console.error(`Error: ${error && error.message ? error.message : error}`);
  process.exitCode = error && error.exitCode ? error.exitCode : 1;
}

if (command === '--version' || command === '-v' || command === 'version') {
  console.log(pkg.version);
} else if (!command) {
  printHelp();
} else if (!commands[command]) {
  printHelp();
  process.exitCode = 1;
} else {
  try {
    const result = commands[command]();
    if (result && typeof result.catch === 'function') result.catch(reportError);
  } catch (error) {
    reportError(error);
  }
}
